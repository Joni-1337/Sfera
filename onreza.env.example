# Скопируйте в ONREZA → Project → Settings → Environment Variables
# Значения лучше взять 1:1 из Vercel (одна база Neon, один JWT_SECRET).

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=тот_же_что_на_vercel_минимум_32_символа

# Сначала URL вида https://project-workspace.onreza.app
# После привязки домена: https://sferaege.ru
APP_URL=https://ВАШ-проект.onreza.app

NODE_ENV=production

SUBSCRIPTION_PRICE_RUB=1990
NEXT_PUBLIC_SUBSCRIPTION_PRICE_RUB=1990

# Пока проверяете деплой без реальных платежей:
# SUBSCRIPTION_STUB=true

RESEND_API_KEY=
EMAIL_FROM=СФЕРА <noreply@sferaege.ru>

# ЮKassa (когда нужна оплата на этом URL)
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# NEXT_PUBLIC_YANDEX_METRIKA_ID=
# NEXT_PUBLIC_TAWK_PROPERTY_ID=
# NEXT_PUBLIC_TAWK_WIDGET_ID=
# NEXT_PUBLIC_LEGAL_NAME=
# NEXT_PUBLIC_LEGAL_INN=
