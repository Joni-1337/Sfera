# Настройки СФЕРЫ на сервере.
# На сервере скопируйте в файл .env в корне проекта:  cp infra/server.env.example .env
# и заполните. Файл .env в git НЕ попадает.

# ── Адрес сайта ──────────────────────────────────────────────
# Домен(ы) для HTTPS через Caddy. На время проверки — поддомен new.sferaege.ru,
# после переключения DNS: sferaege.ru, www.sferaege.ru
SITE_DOMAIN=new.sferaege.ru
# Публичный адрес (ссылки в письмах, ЮKassa, SEO)
APP_URL=https://new.sferaege.ru

# ── База данных (PostgreSQL в Docker на этом же сервере) ────
POSTGRES_DB=sfera
POSTGRES_USER=sfera
# Длинный случайный пароль: openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Сессии ───────────────────────────────────────────────────
# ТОТ ЖЕ, что был на Vercel, — тогда пользователей не выкинет из аккаунтов.
# Если старого нет: openssl rand -hex 32  (все просто войдут заново)
JWT_SECRET=

# ── Почта (российский SMTP-сервис) ──────────────────────────
# Подойдёт любой SMTP-сервис (Selectel, Unisender Go, SMTP.bz, Яндекс Cloud Postbox…).
# Хост, порт, логин и пароль возьмите в панели выбранного сервиса.
SMTP_HOST=
SMTP_PORT=465
# true — TLS сразу (порт 465); false — STARTTLS (порты 587/25/2525)
# SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Адрес отправителя — домен должен быть подтверждён у SMTP-сервиса (SPF/DKIM)
EMAIL_FROM=СФЕРА <noreply@sferaege.ru>

# ── Подписка и ЮKassa ───────────────────────────────────────
SUBSCRIPTION_PRICE_RUB=1990
NEXT_PUBLIC_SUBSCRIPTION_PRICE_RUB=1990
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# YOOKASSA_SEND_RECEIPTS=true
# Тестовая оплата без ЮKassa (только для проверки!)
# SUBSCRIPTION_STUB=true

# ── Аналитика и поиск ───────────────────────────────────────
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Админка маркетинга (/admin/marketing) ───────────────────
MARKETING_ADMIN_EMAIL=

# ── Реквизиты (/requisites) ─────────────────────────────────
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_INN=
# NEXT_PUBLIC_LEGAL_PHONE=

# ── Чат поддержки Tawk.to (зарубежный, необязателен) ────────
# Оставьте пустым, чтобы не грузить сторонний скрипт.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
# NEXT_PUBLIC_TAWK_WIDGET_ID=
