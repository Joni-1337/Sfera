# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# JWT secret (обязательно смените! минимум 32 случайных символа)
JWT_SECRET="change-me-to-long-random-string"

# Публичный URL сайта
APP_URL="https://sferaege.ru"

# Email (Resend) — после публикации домена добавьте sferaege.ru в Resend + DNS
RESEND_API_KEY=""
EMAIL_FROM="СФЕРА <noreply@sferaege.ru>"
# EMAIL_FORCE_RESEND=true

# Пока ЮKassa не подключена — тестовая активация подписки на сервере:
# SUBSCRIPTION_STUB=true

# Цена подписки (Production — 1990 ₽/мес)
SUBSCRIPTION_PRICE_RUB=1990
NEXT_PUBLIC_SUBSCRIPTION_PRICE_RUB=1990

# Порт для Node (если хостинг не задаёт сам)
# PORT=3000
