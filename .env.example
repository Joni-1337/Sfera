# Database (Neon PostgreSQL) — см. neon.env.example
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# JWT secret for session cookies (change in production!)
JWT_SECRET="your-secret-key-here"

# Public URL of the app (ссылки подтверждения email в письмах)
# Локально: http://localhost:3001
# Production: https://sferaege.ru
APP_URL="http://localhost:3001"

# Email via Resend (https://resend.com)
RESEND_API_KEY=""
# После верификации домена sferaege.ru в Resend:
EMAIL_FROM="СФЕРА <noreply@sferaege.ru>"
# Принудительно слать письма через Resend даже в dev (после настройки DNS):
# EMAIL_FORCE_RESEND=true

# Enable test subscription checkout outside development
# SUBSCRIPTION_STUB=true

# ЮKassa — оплата подписки (https://yookassa.ru)
# YOOKASSA_SHOP_ID=""
# YOOKASSA_SECRET_KEY=""
